{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Peak车队中心",
  "version": "4.1.1",
  "identifier": "cn.peakvtc.center",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": null,
    "frontendDist": "http://df.peakvtc.cn"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Peak车队中心",
        "width": 336,
        "height": 470,
        "resizable": false,
        "center": true,
        "visible": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDUxNjcwNTFFOUIzNjA5NUEKUldSYUNUYWJIZ1ZuVVVwTE1LZHJCa3NFelB4RnFwaXlza3AwVktzMk5iUlMycWVBZ1phZ0sweTIK",
      "endpoints": [
        "http://df.peakvtc.cn/api/client/update/{{target}}/{{arch}}/{{current_version}}"
      ],
      "dangerousInsecureTransportProtocol": true,
      "windows": {
        "installMode": "quiet"
      }
    }
  }
}
