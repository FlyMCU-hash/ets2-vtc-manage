PORT=3000
SESSION_SECRET=请改成随机长字符串

# EVM 数据 API（玩家/地图在线/DLC/服务器）
EVM_API_BASE=https://api.pzvtcm.online

# 可选：Peak 在 TruckersMP 的车队 ID（用于同步入队时间；不填则按成员 TMP 自动识别）
TMP_VTC_ID=

# MySQL（peak 库）
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=peak
DB_PASSWORD=你的密码
DB_NAME=peak

# 活动存档本地根目录（空 = 项目下 uploads/activities）
# 启用 OSS 后仅作上传暂存；成功后会删本地文件
UPLOAD_ROOT=
UPLOAD_MAX_MB=50

# 阿里云 OSS 活动存档（四项填齐后启用；留空则继续本地磁盘）
# Bucket 建议私有 + 阻止公共访问；接档器用签名 URL 直连下载
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET=peak-tmp
OSS_REGION=oss-cn-shanghai
OSS_PREFIX=activities
OSS_SIGN_EXPIRES=1800

# 机器人开放 API（与 AstrBot 插件同名配置）
BOT_API_TOKEN=请改成强随机串
