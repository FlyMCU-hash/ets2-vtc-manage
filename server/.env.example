# 接口监听端口
PORT=3000
# 登录会话签名密钥。当前接口用数据库令牌，不读取这项，保留给原服务
SESSION_SECRET=

# 本机扩展服务地址。当前接口不读取这项，保留给原服务
EVM_API_BASE=http://127.0.0.1:9100

# MySQL 地址
DB_HOST=127.0.0.1
# MySQL 端口
DB_PORT=3306
# MySQL 用户名
DB_USER=peak
# MySQL 密码
DB_PASSWORD=
# MySQL 数据库名，对应 schema.sql 里的 peak
DB_NAME=peak

# 没配 OSS 时，活动存档放在这个本机目录。留空则用 server/uploads
UPLOAD_ROOT=
# 单个活动存档最大体积，单位 MB
UPLOAD_MAX_MB=50

# 机器人调用接口的令牌。当前接口不读取这项，保留给原服务
BOT_API_TOKEN=

# 设为 1 时原服务只开放 Peak 接口。当前接口不读取这项
#PEAK_API_ONLY=1

# 阿里云 OSS AccessKey ID。和下面三项都填写后，活动存档上传到 OSS
OSS_ACCESS_KEY_ID=
# 阿里云 OSS AccessKey Secret
OSS_ACCESS_KEY_SECRET=
# OSS 桶名
OSS_BUCKET=peak-tmp-v2
# OSS 地域，例如上海
OSS_REGION=oss-cn-shanghai
# 桶内目录前缀，文件路径为 activities/活动编号/文件名
OSS_PREFIX=activities
# 下载链接签名有效期，单位秒
OSS_SIGN_EXPIRES=1800
